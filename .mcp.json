{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.3.0"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path",
        "/opt/pw-browsers/chromium",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==2.0.0",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--agent-interface",
        "tools",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false"
      ]
    }
  }
}
